{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "setup:intake": "tsx src/scripts/setup-intake.ts",
    "pdf:leitfaden": "tsx scripts/generate-leitfaden-pdf.ts",
    "pdf:checkliste": "tsx scripts/generate-checkliste-pdf.ts",
    "pvs:reconcile": "tsx scripts/pvs-reconcile.ts",
    "pvs:seed-staging": "tsx scripts/pvs-seed-staging.ts",
    "backfill:first-touch": "tsx scripts/backfill-first-touch.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@eins/ui": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.1.5",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.9",
    "cmdk": "^1.0.4",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "lucide-react": "^0.456.0",
    "nanoid": "^5.0.9",
    "next": "^15.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.3",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.47",
